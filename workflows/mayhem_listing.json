{
  "id": "mayhem_listing",
  "name": "Mayhem Marketplace Auto-Publisher",
  "marketplace": "mayhem",
  "start_url": "https://mayhemmarketplace.com",
  "description": "Uploads product photos/files, fills Title, Description, Price, Tags, and publishes on Mayhem Marketplace. Use 'Record / Teach' to customize selectors for your exact seller page.",
  "updated_at": "2026-11-14T15:02:27.984652",
  "steps": [
    {
      "action": "goto",
      "url": "{{mayhem_create_url}}",
      "note": "Open Mayhem Marketplace create listing URL"
    },
    {
      "action": "wait",
      "seconds": 3,
      "note": "Wait for page load"
    },
    {
      "action": "upload_files",
      "selector": "input[type='file'][accept*='image'], input[type='file']",
      "value": "{{images}}",
      "note": "Upload product images"
    },
    {
      "action": "fill",
      "selector": "input[name*='title' i], input[name*='name' i], input[placeholder*='title' i], input[placeholder*='name' i]",
      "value": "{{title}}",
      "note": "Fill Product Title"
    },
    {
      "action": "fill",
      "selector": "textarea[name*='description' i], textarea[placeholder*='description' i], [contenteditable='true'], textarea",
      "value": "{{description}}",
      "note": "Fill Product Description"
    },
    {
      "action": "fill",
      "selector": "input[name*='price' i], input[placeholder*='price' i], input[type='number']",
      "value": "{{price}}",
      "note": "Fill Price"
    },
    {
      "action": "add_tags",
      "selector": "input[name*='tag' i], input[placeholder*='tag' i]",
      "button_selector": "button:has-text('Add')",
      "value": "{{tags}}",
      "note": "Add Tags"
    },
    {
      "action": "publish_or_draft",
      "publish_selector": "button:has-text('Publish'), button:has-text('Create'), button:has-text('Submit'), button[type='submit']",
      "draft_selector": "button:has-text('Draft'), button:has-text('Save')",
      "note": "Publish Listing"
    }
  ]
}